# Copiar este archivo a .env.local (desarrollo) y configurar las mismas
# claves como variables de entorno del proyecto en Vercel (producción).
# NUNCA subir .env.local a GitHub.

# Panel del proyecto Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Opcional — solo para scripts administrativos ejecutados en servidor
# (nunca en código de cliente, nunca commiteada). No es necesaria para
# la primera entrega: el primer usuario se crea desde el panel de Supabase.
# SUPABASE_SERVICE_ROLE_KEY=
