# Copiar este archivo a .env.local (desarrollo) y configurar las mismas
# claves como variables de entorno del proyecto en Vercel (producción).
# NUNCA subir .env.local a GitHub.

# Panel del proyecto Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Necesaria a partir del envío programado por correo de Informativos
# Semanales (src/app/api/cron/send-bulletins/route.ts): ese endpoint no
# tiene sesión de usuario (lo dispara el cron de Vercel, no un navegador),
# así que necesita esta clave para leer destinatarios y registrar el envío
# sin RLS. Nunca en código de cliente, nunca commiteada.
# Panel de Supabase -> Settings -> API -> "service_role" (secreta)
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/cron/send-bulletins para que solo el cron de Vercel (o quien
# conozca este secreto) pueda dispararlo — sin esto, cualquiera podría
# forzar un envío masivo visitando la URL. Vercel puede generarlo
# automáticamente al configurar el cron job desde su panel, o genera uno tú
# mismo (ej. `openssl rand -hex 32`) y pégalo también en Vercel -> Settings
# -> Environment Variables.
CRON_SECRET=

# Envío del formulario de Contacto (/contacto -> src/app/api/contact/route.ts),
# vía Resend (resend.com). Sin esta clave, el endpoint responde 500 con un
# mensaje claro en vez de fallar en silencio.
# 1. Crear cuenta gratuita en https://resend.com
# 2. Dashboard -> API Keys -> crear una nueva clave
# 3. Pegar aquí (y en Vercel -> Settings -> Environment Variables), nunca en Git
RESEND_API_KEY=

# Remitente del correo del formulario de Contacto. Sin dominio propio
# verificado en Resend, usa el remitente de pruebas de Resend
# (onboarding@resend.dev) como valor por defecto si esta variable no está
# configurada. Para producción, verifica un dominio propio en Resend
# (Dashboard -> Domains) y usa un remitente de ese dominio, p. ej.:
# CONTACT_FROM_EMAIL="Escuela Pedro Viveros Ormeño <contacto@escuelapedroviveros.cl>"
CONTACT_FROM_EMAIL=

# Remitente del envío programado de Informativos Semanales. Opcional — si no
# se configura, usa CONTACT_FROM_EMAIL, y si tampoco existe, el remitente de
# pruebas de Resend.
# BULLETIN_FROM_EMAIL="Escuela Pedro Viveros Ormeño <informativos@escuelapedroviveros.cl>"
BULLETIN_FROM_EMAIL=
